# The visualizer tree is interactive, so drive the REPL over stdin.
#
# --strict-whitespace is the point: the gutter, the connectors and the
# indentation are the feature. Without it FileCheck canonicalizes horizontal
# whitespace and every column assertion below passes vacuously.

# RUN: printf 'tree\ntree 1\nexpand all\nfilter kind create\ntree\nq\n' | %dpm open %root/tests/fixtures/nested-tree.trace.json --visualize --color never | FileCheck --strict-whitespace %s

# The banner has to advertise the commands: a reader who never types `help`
# learns them only from here.
# CHECK:tree: tree [depth], collapse [id|all], expand [id|all]

# Nesting is drawn with the same connectors as the printed trace, so a reader
# can tell a sibling from a child without counting spaces.
# CHECK:=> └── EXERCISE #5:0 Settlement:Settlement.Settle
# CHECK-NEXT:       ├── EXERCISE #5:1 Asset:Asset.Transfer
# CHECK-NEXT:       │   ├── ARCHIVE  #5:2 Asset:Asset
# CHECK-NEXT:       │   └── CREATE   #5:3 Asset:Asset
# CHECK-NEXT:       │       └── CREATE   #5:4 Receipt:Receipt
# CHECK-NEXT:       └── EXERCISE #5:5 Fee:Fee.Charge
# CHECK-NEXT:           └── CREATE   #5:6 Fee:Fee

# `tree 1` folds below a level. The hidden-count line carries the count and the
# command to reopen it, which is why the tree needs no separate marker.
# CHECK:=> └── EXERCISE #5:0 Settlement:Settlement.Settle
# CHECK-NEXT:       ├── EXERCISE #5:1 Asset:Asset.Transfer
# CHECK-NEXT:       │   ... 3 events hidden (expand #5:1)
# CHECK-NEXT:       └── EXERCISE #5:5 Fee:Fee.Charge
# CHECK-NEXT:           ... 1 event hidden (expand #5:5)

# CHECK:expanded all

# With a filter set, matches are marked in a fixed left gutter so they can be
# scanned straight down the page, and the structure survives.
# CHECK:filter: kind create  (3 of 7 steps)
# CHECK:     └── EXERCISE #5:0 Settlement:Settlement.Settle
# CHECK-NEXT:         ├── EXERCISE #5:1 Asset:Asset.Transfer
# CHECK-NEXT:         │   ├── ARCHIVE  #5:2 Asset:Asset
# CHECK-NEXT:* =>     │   └── CREATE   #5:3 Asset:Asset
# CHECK-NEXT:*        │       └── CREATE   #5:4 Receipt:Receipt
# CHECK-NEXT:         └── EXERCISE #5:5 Fee:Fee.Charge
# CHECK-NEXT:*            └── CREATE   #5:6 Fee:Fee
