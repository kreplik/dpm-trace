# Daml-independent: normalizes captured Ledger API reassignment updates
# (unassign on the source synchronizer, assign on the target) and checks the
# rendered tree, so it runs without a Canton node or Daml toolchain.
# RUN: %python %root/tests/check-reassignment.py %root | FileCheck %s

# CHECK: UNASSIGN Asset:Asset
# CHECK: reassignment:{{.*}}sync-a::{{.*}}->{{.*}}sync-b::
# CHECK: counter: 1
# CHECK: ASSIGN Asset:Asset
# CHECK: payload:{{.*}}GOLD
# CHECK: dpm trace reassignment checks passed
